# Copy to .env and fill in real values. Never commit .env.

# LLM provider used by the narration agent.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Outbound alert webhook (Discord or Slack). Either style of URL is detected.
WEBHOOK_URL=

# Optional email delivery. Both SMTP_HOST and ALERT_TO are required to send.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_TO=

# Chroma persistence directory (vector store for incident memory).
CHROMA_DIR=.chroma
