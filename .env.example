# Copy to .env and fill in real values. Never commit .env.

# LLM provider used by the narration agent.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Outbound alert webhook (Discord or Slack).
ALERT_WEBHOOK_URL=

# Chroma persistence directory.
CHROMA_DIR=data/chroma

# OpenAI-compatible embeddings endpoint for sentence-transformers / Chroma.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=
